{
  "name": "shotcars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch src/server.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "catalogo:importar": "node --env-file-if-exists=.env scripts/importar-catalogo.mjs",
    "catalogo:curadoria": "node --env-file-if-exists=.env scripts/aplicar-curadoria.mjs",
    "ia:modelos": "node --env-file-if-exists=.env scripts/listar-modelos-ia.mjs",
    "ia:testar": "node --env-file-if-exists=.env scripts/testar-ia.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
