# MongoDB Atlas: Database > Connect > Drivers. Troque <password> pela senha do usuário do banco.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shotcars

# Gere um segredo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-isto

# Reconhecimento: ollama (Ollama Cloud) ou mock (sorteio, para testar o fluxo sem IA)
RECONHECEDOR=ollama
# Ollama Cloud direto: crie a chave em https://ollama.com/settings/keys
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
# Precisa ser um modelo com visão. Veja os disponíveis com: npm run ia:modelos
# Outros com visão para comparar no teste de 50 fotos: kimi-k3, mistral-large-4, mistral-large-3:675b
OLLAMA_MODEL=gemma4:31b
# Alternativa: pelo Ollama do seu Mac depois de "ollama signin":
#   OLLAMA_HOST=http://localhost:11434  OLLAMA_API_KEY=  OLLAMA_MODEL=gemma4:31b-cloud

# Opcional: token da FIPE (sobe o limite de 500 para 1000 req/dia)
FIPE_TOKEN=

PORT=3001
